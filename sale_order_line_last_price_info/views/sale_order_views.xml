<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='order_line']/tree/field[@name='price_unit']"
        position="before"
      >
                <field name="sale_last_price_unit" optional="show" />
                <field name="invoice_last_price_unit" optional="show" />
            </xpath>
            <xpath expr="//field[@name='order_line']/tree">
                <button
          name="button_recompute_last_price_unit"
          type="object"
          icon="fa-refresh"
        />
            </xpath>
            <xpath
        expr="//field[@name='order_line']/kanban/field[@name='price_unit']"
        position="before"
      >
                <field name="sale_last_price_unit" />
                <field name="invoice_last_price_unit" />
            </xpath>
            <xpath
        expr="//field[@name='order_line']/kanban//t[@t-esc='record.price_unit.value']/.."
        position="before"
      >
                <span>LPS: <t t-esc="record.sale_last_price_unit.value" /></span>
                <span>LPI: <t t-esc="record.invoice_last_price_unit.value" /></span>
            </xpath>
            <xpath
        expr="//field[@name='order_line']/form//field[@name='price_unit']"
        position="before"
      >
                <field name="sale_last_price_unit" />
                <field name="invoice_last_price_unit" />
            </xpath>
        </field>
    </record>
</odoo>
