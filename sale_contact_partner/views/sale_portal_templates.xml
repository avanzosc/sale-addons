<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
    id="sale_order_portal_content"
    inherit_id="sale.sale_order_portal_content"
  >
        <xpath expr="//span[@id='shipping_address']" position="after">
            <t t-if="sale_order.partner_contact_id and sale_order.partner_contact_id != sale_order.partner_id">
                <div id="contact" class="mt-3">
                    <h5 class="mb-1">Contact</h5>
                    <hr class="mt-1 mb-2" />
                    <div t-field="sale_order.partner_contact_id.name" />
                </div>
            </t>
        </xpath>
    </template>
</odoo>
