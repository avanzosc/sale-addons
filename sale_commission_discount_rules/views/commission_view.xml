<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="commission_form_inherit_discount_rules" model="ir.ui.view">
    <field name="name">commission.form.inherit.discount.rules</field>
    <field name="model">commission</field>
    <field name="inherit_id" ref="commission_oca.commission_form" />
    <field name="arch" type="xml">
      <field name="section_ids" position="after">
        <group colspan="4">
          <field
            name="formula_data_ids"
            widget="one2many"
            colspan="4"
            nolabel="1"
            invisible="commission_type != 'filter'"
          >
            <list string="Formula Data" editable="bottom">
              <field name="category" />
              <field name="operation" />
              <field name="discount" />
              <field name="commission" />
            </list>
          </field>
        </group>
      </field>
    </field>
  </record>
</odoo>
