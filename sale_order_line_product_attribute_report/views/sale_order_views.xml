<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='sequence']" position="before" >
                <field name="order_id" invisible="1"/>
                <field name="bottom_graphic" invisible="1"/>
                <field name="top_graphic" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='sequence']" position="after" >
                <field name="id" invisible="1"/>
            </xpath>
            <field name="order_line" position="attributes">
                <attribute name="default_order">order_id, bottom_graphic, top_graphic, sequence, id</attribute>
            </field>
        </field>
    </record>
</odoo>
