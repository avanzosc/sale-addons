<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_sale_project_inherit_form" model="ir.ui.view">
    <field name="model">project.task</field>
    <field name="inherit_id" ref="sale_project.view_sale_project_inherit_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[@name='sale_line_div']" position="after">
        <field name="sale_line_product_id" invisible="not partner_id" readonly="1" />
        <field
          name="sale_line_product_uom_qty"
          invisible="not partner_id"
          readonly="1"
        />
      </xpath>
    </field>
  </record>
</odoo>
