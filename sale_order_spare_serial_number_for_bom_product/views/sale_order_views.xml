<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='order_line']/list/field[@name='product_id']"
        position="attributes"
      >
        <attribute
          name="domain"
        >[('id','in', context.get('allowed_product_ids', []))]</attribute>
      </xpath>

      <field name="payment_term_id" position="after">
        <field name="spare_serial_number_id" />
        <field name="allowed_product_ids" invisible="1" />
      </field>
      <field name="order_line" position="attributes">
        <attribute
          name="context"
        >{'default_spare_serial_number_id': spare_serial_number_id,
        'allowed_product_ids': allowed_product_ids}
        </attribute>
      </field>
      <xpath
        expr="//field[@name='order_line']/list/field[@name='product_id']"
        position="after"
      >
        <field name="spare_serial_number_id" invisible="1" />
      </xpath>
    </field>
  </record>
  <record id="view_order_tree" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="spare_serial_number_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="view_quotation_tree" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="spare_serial_number_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="view_sales_order_filter" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter" />
    <field name="arch" type="xml">
      <field name="team_id" position="after">
        <field name="spare_serial_number_id" />
      </field>
    </field>
  </record>
</odoo>
