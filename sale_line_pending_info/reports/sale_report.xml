<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_sale_report_pending_info_tree" model="ir.ui.view">
        <field name="name">sale.report.pending.info.tree</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="qty_pending_delivery" optional="show"/>
                <field name="amount_pending_delivery" widget="monetary"
                       options="{'currency_field': 'currency_id'}" optional="show"/>
                <field name="qty_pending_invoicing" optional="show"/>
                <field name="amount_pending_invoicing" widget="monetary"
                       options="{'currency_field': 'currency_id'}" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
