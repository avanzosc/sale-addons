<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_order_pending_info_form_view" model="ir.ui.view">
    <field name="name">sale.order.pending.info.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='order_lines']" position="after">
        <page string="Pending Info">
          <group>
            <group string="Delivery">
              <field name="total_qty_pending_delivery" readonly="1" />
              <field
                name="total_amount_pending_delivery"
                widget="monetary"
                options="{'currency_field': 'currency_id'}"
                readonly="1"
              />
            </group>
            <group string="Invoicing">
              <field name="total_qty_pending_invoicing" readonly="1" />
              <field
                name="total_amount_pending_invoicing"
                widget="monetary"
                options="{'currency_field': 'currency_id'}"
                readonly="1"
              />
              <field name="total_qty_shipped_pending_invoicing" readonly="1" />
              <field
                name="total_amount_shipped_pending_invoicing"
                widget="monetary"
                options="{'currency_field': 'currency_id'}"
                readonly="1"
              />
            </group>
            <group string="Totals">
              <field name="qty_ordered" readonly="1" string="Total Units Ordered" />
              <field name="qty_delivered" readonly="1" string="Total Qty Delivered" />
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <record id="sale_order_pending_info_tree_view" model="ir.ui.view">
    <field name="name">sale.order.pending.info.tree</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='amount_total']" position="after">
        <field name="total_qty_pending_delivery" optional="show" />
        <field
          name="total_amount_pending_delivery"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="total_qty_pending_invoicing" optional="show" />
        <field
          name="total_amount_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="total_qty_shipped_pending_invoicing" optional="show" />
        <field
          name="total_amount_shipped_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="qty_ordered" optional="show" string="Total Units Ordered" />
        <field name="qty_delivered" optional="show" string="Total Qty Delivered" />
      </xpath>
    </field>
  </record>
</odoo>
