<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_order_line_pending_info_tree_input" model="ir.ui.view">
    <field name="name">sale.order.line.pending.info.tree.input</field>
    <field name="model">sale.order.line</field>
    <field
      name="inherit_id"
      ref="sale_order_line_input.view_sales_order_line_input_tree"
    />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_price_tax_incl_excl']" position="after">
        <field name="qty_pending_delivery" optional="show" />
        <field
          name="amount_pending_delivery"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="qty_pending_invoicing" optional="show" />
        <field
          name="amount_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="qty_shipped_pending_invoicing" optional="show" />
        <field
          name="amount_shipped_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="team_id" optional="show" />
      </xpath>
    </field>
  </record>

  <record id="sale_order_line_pending_info_search_input" model="ir.ui.view">
    <field name="name">sale.order.line.pending.info.search.input</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale_order_line_menu.view_sales_order_line_filter" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_id']" position="after">
        <field name="qty_pending_delivery" />
        <field name="qty_pending_invoicing" />
        <field name="qty_shipped_pending_invoicing" />
        <field name="team_id" />
      </xpath>
    </field>
  </record>

  <record id="sale_order_line_pending_info_tree_menu" model="ir.ui.view">
    <field name="name">sale.order.line.pending.info.tree.menu</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale_order_line_menu.sale_order_line_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='price_total']" position="after">
        <field name="qty_pending_delivery" optional="show" />
        <field
          name="amount_pending_delivery"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="qty_pending_invoicing" optional="show" />
        <field
          name="amount_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="qty_shipped_pending_invoicing" optional="show" />
        <field
          name="amount_shipped_pending_invoicing"
          widget="monetary"
          options="{'currency_field': 'currency_id'}"
          optional="show"
        />
        <field name="team_id" optional="show" />
      </xpath>
    </field>
  </record>

  <record id="sale_order_line_pending_info_search_menu" model="ir.ui.view">
    <field name="name">sale.order.line.pending.info.search.menu</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale_order_line_menu.view_sales_order_line_filter" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_id']" position="after">
        <field name="qty_pending_delivery" />
        <field name="qty_pending_invoicing" />
        <field name="qty_shipped_pending_invoicing" />
        <field name="team_id" />
      </xpath>
    </field>
  </record>
</odoo>
