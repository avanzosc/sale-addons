<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <header position="inside">
        <button
          name="button_validate_everything"
          type="object"
          string="Validate Everything"
          class="oe_highlight"
        />
      </header>
      <xpath expr="//button[@name='button_confirm_pickings']" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
      <xpath
        expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
        position="after"
      >
        <field name="return_qty" />
      </xpath>
      <xpath
        expr="//field[@name='order_line']/form//div[@name='ordered_qty']"
        position="after"
      >
        <field name="return_qty" />
      </xpath>
      <xpath
        expr="//field[@name='order_line']/kanban//div[field[@name='product_uom_qty']]"
        position="after"
      >
        <div class="text-muted" invisible="not return_qty">
                    Return Qty:
                    <field name="return_qty" /> <field name="product_uom" />
                </div>
      </xpath>
    </field>
  </record>
</odoo>
