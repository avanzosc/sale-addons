<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field
      name="name"
    >res.config.settings.view.form.inherit.sale.picking.return.containers</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//app[@name='sale_management']/block[@name='invoicing_setting_container']"
        position="inside"
      >
        <setting
          id="return_journal_setting"
          string="Return Journal"
          help="Account journal for returns"
        >
          <field name="return_journal_id" options="{'no_create': True}" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
