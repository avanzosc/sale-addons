<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <block name="catalog_setting_container" position="after">
        <block title="Offers" name="offers-information">
          <setting
            id="allow-old-offers-modification"
            string="Allow Modification Of Old Offers"
          >
            <field name="allow_modification_old_offers" />
          </setting>
        </block>
      </block>
    </field>
  </record>
</odoo>
