<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="sale_order_line_history_report_view_tree" model="ir.ui.view">
    <field name="name">sale.order.line.history.report list</field>
    <field name="model">sale.order.line.history.report</field>
    <field name="arch" type="xml">
      <list
        create="0"
        edit="0"
        delete="0"
        default_order="date_order_missing asc, date_order desc, id desc"
      >
        <field name="date_order" />
        <field name="source" />
        <field name="partner_id" />
        <field name="customer_country_id" optional="hide" />
        <field name="sales_team" optional="hide" />
        <field name="order_name" />
        <field name="client_order_ref" optional="hide" />
        <field name="product_id" />
        <field name="product_categ_id" optional="hide" />
        <field name="quantity" />
        <field name="price_unit" />
        <field name="discount" optional="hide" />
        <field
          name="item_total_amount"
          string="Total de artículo"
          sum="Total de artículo"
        />
        <field name="subtotal" sum="Subtotal" />
        <field name="total" sum="Total" />
        <field name="state" optional="hide" />
        <field name="company_id" groups="base.group_multi_company" optional="hide" />
      </list>
    </field>
  </record>

  <record id="sale_order_line_history_report_view_pivot" model="ir.ui.view">
    <field name="name">sale.order.line.history.report pivot</field>
    <field name="model">sale.order.line.history.report</field>
    <field name="arch" type="xml">
      <pivot string="Sales History Lines">
        <field name="source" type="row" />
        <field name="sales_team" type="row" />
        <field name="product_categ_id" type="row" />
        <field name="customer_country_id" type="row" />
        <field name="date_order" type="col" interval="month" />
        <field name="line_id" invisible="1" />
        <field name="price_unit" invisible="1" />
        <field name="discount" invisible="1" />
        <field name="subtotal" invisible="1" />
        <field name="total" invisible="1" />
        <field name="subtotal_min" invisible="1" />
        <field name="total_min" invisible="1" />
        <field name="quantity" type="measure" string="Cantidad" />
        <field name="item_total_amount" type="measure" string="Total de artículo" />
        <field name="subtotal_max" type="measure" string="Subtotal max" />
        <field name="total_max" type="measure" string="Total max" />
      </pivot>
    </field>
  </record>

  <record id="sale_order_line_history_report_view_search" model="ir.ui.view">
    <field name="name">sale.order.line.history.report search</field>
    <field name="model">sale.order.line.history.report</field>
    <field name="arch" type="xml">
      <search string="Sales History Lines">
        <field name="partner_id" />
        <field name="commercial_partner_id" />
        <field name="customer_country_id" />
        <field name="sales_team" />
        <field name="order_name" />
        <field name="product_id" />
        <field name="product_categ_id" />
        <field name="date_order" />
        <filter
          string="Historical"
          name="historical_true"
          domain="[('historical', '=', True)]"
        />
        <filter
          string="Non Historical"
          name="historical_false"
          domain="[('historical', '=', False)]"
        />
        <group expand="0" string="Group By">
          <filter
            string="Customer"
            name="group_partner"
            domain="[]"
            context="{'group_by': 'partner_id'}"
          />
          <filter
            string="Commercial Partner"
            name="group_commercial_partner"
            domain="[]"
            context="{'group_by': 'commercial_partner_id'}"
          />
          <filter
            string="Product"
            name="group_product"
            domain="[]"
            context="{'group_by': 'product_id'}"
          />
          <filter
            string="Product Category"
            name="group_product_category"
            domain="[]"
            context="{'group_by': 'product_categ_id'}"
          />
          <filter
            string="Team"
            name="group_team"
            domain="[]"
            context="{'group_by': 'sales_team'}"
          />
          <filter
            string="Customer Country"
            name="group_customer_country"
            domain="[]"
            context="{'group_by': 'customer_country_id'}"
          />
          <filter
            string="Month"
            name="group_month"
            domain="[]"
            context="{'group_by': 'date_order:month'}"
          />
          <filter
            string="Source"
            name="group_source"
            domain="[]"
            context="{'group_by': 'source'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="sale_order_line_history_report_action" model="ir.actions.act_window">
    <field name="name">Sales History Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sale.order.line.history.report</field>
    <field name="view_mode">list,pivot</field>
    <field name="view_id" ref="sale_order_line_history_report_view_tree" />
    <field name="search_view_id" ref="sale_order_line_history_report_view_search" />
  </record>

  <menuitem
    id="sale_order_line_history_report_menu"
    parent="sale.menu_sale_report"
    action="sale_order_line_history_report_action"
    sequence="60"
  />
</odoo>
