<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="sale_order_import_line_view_form_info_fields" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_form"
    />
    <field name="arch" type="xml">
      <field name="total_order_amount" position="after">
        <field name="salesorder_external_id" readonly="state == 'done'" />
        <field name="origin_import" readonly="state == 'done'" />
        <field name="sales_team_import" readonly="state == 'done'" />
        <field name="currency_code_import" readonly="state == 'done'" />
        <field name="entity_discount_percent" readonly="state == 'done'" />
        <field name="order_name" readonly="state == 'done'" />
        <field name="discount" readonly="state == 'done'" />
        <field name="product_uos_qty" readonly="state == 'done'" />
        <field name="quantity_invoiced" readonly="state == 'done'" />
        <field name="quantity_packed" readonly="state == 'done'" />
        <field name="usage_unit" readonly="state == 'done'" />
        <field name="warehouse_name_import" readonly="state == 'done'" />
        <field name="line_type" readonly="state == 'done'" />
        <field name="salesman_name" readonly="state == 'done'" />
        <field name="invoiced" readonly="state == 'done'" />
        <field name="line_subtotal_amount" readonly="state == 'done'" />
        <field name="item_total_amount" readonly="state == 'done'" />
        <field name="line_total_amount" readonly="state == 'done'" />
        <field name="payment_terms_import" readonly="state == 'done'" />
        <field name="payment_terms_label_import" readonly="state == 'done'" />
        <field name="purchase_order_import" readonly="state == 'done'" />
        <field name="exchange_rate_import" readonly="state == 'done'" />
        <field name="included_tax_amount_import" readonly="state == 'done'" />
      </field>
    </field>
  </record>

  <record id="sale_order_import_line_view_tree_info_fields" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_tree"
    />
    <field name="arch" type="xml">
      <field name="total_order_amount" position="after">
        <field
          name="salesorder_external_id"
          readonly="state == 'done'"
          optional="hide"
        />
        <field name="origin_import" readonly="state == 'done'" optional="hide" />
        <field name="sales_team_import" readonly="state == 'done'" optional="hide" />
        <field name="currency_code_import" readonly="state == 'done'" optional="hide" />
        <field
          name="entity_discount_percent"
          readonly="state == 'done'"
          optional="hide"
        />
        <field name="order_name" readonly="state == 'done'" optional="hide" />
        <field name="discount" readonly="state == 'done'" optional="hide" />
        <field name="product_uos_qty" readonly="state == 'done'" optional="hide" />
        <field name="quantity_invoiced" readonly="state == 'done'" optional="hide" />
        <field name="quantity_packed" readonly="state == 'done'" optional="hide" />
        <field name="usage_unit" readonly="state == 'done'" optional="hide" />
        <field
          name="warehouse_name_import"
          readonly="state == 'done'"
          optional="hide"
        />
        <field name="line_type" readonly="state == 'done'" optional="hide" />
        <field name="salesman_name" readonly="state == 'done'" optional="hide" />
        <field name="invoiced" readonly="state == 'done'" optional="hide" />
        <field name="line_subtotal_amount" readonly="state == 'done'" optional="hide" />
        <field name="item_total_amount" readonly="state == 'done'" optional="hide" />
        <field name="line_total_amount" readonly="state == 'done'" optional="hide" />
        <field name="payment_terms_import" readonly="state == 'done'" optional="hide" />
        <field
          name="payment_terms_label_import"
          readonly="state == 'done'"
          optional="hide"
        />
        <field
          name="purchase_order_import"
          readonly="state == 'done'"
          optional="hide"
        />
        <field name="exchange_rate_import" readonly="state == 'done'" optional="hide" />
        <field
          name="included_tax_amount_import"
          readonly="state == 'done'"
          optional="hide"
        />
      </field>
    </field>
  </record>

  <record id="sale_order_import_line_view_form_process_historical" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_form"
    />
    <field name="arch" type="xml">
      <button name="action_process" position="attributes">
        <attribute name="invisible">historical</attribute>
      </button>
    </field>
  </record>

  <record id="sale_order_import_line_view_search_historical" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_search"
    />
    <field name="arch" type="xml">
      <field name="product_id" position="before">
        <field name="order_name" />
      </field>
      <filter name="error" position="after">
        <filter
          string="Historical"
          name="historical_true"
          domain="[('historical', '=', True)]"
        />
        <filter
          string="Non Historical"
          name="historical_false"
          domain="[('historical', '=', False)]"
        />
      </filter>
    </field>
  </record>

  <record id="sale_order_import_line_view_form_sku_label" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_form"
    />
    <field name="arch" type="xml">
      <field name="product_code" position="attributes">
        <attribute name="string">SKU</attribute>
      </field>
    </field>
  </record>

  <record id="sale_order_import_line_view_tree_sku_visible" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_tree"
    />
    <field name="arch" type="xml">
      <field name="product_code" position="attributes">
        <attribute name="string">SKU</attribute>
        <attribute name="optional">show</attribute>
      </field>
    </field>
  </record>

  <record id="sale_order_import_line_view_pivot_historical" model="ir.ui.view">
    <field name="name">sale.order.import.line historical pivot</field>
    <field name="model">sale.order.import.line</field>
    <field name="arch" type="xml">
      <pivot string="Historical Imported Lines">
        <field name="customer_name" type="row" string="Nombre cliente" />
        <field name="product_name" type="row" string="Nombre producto" />
        <field name="date_order" type="col" interval="month" />
        <field name="price_unit" invisible="1" />
        <field name="entity_discount_percent" invisible="1" />
        <field name="quantity_invoiced" invisible="1" />
        <field name="quantity_packed" invisible="1" />
        <field name="discount" invisible="1" />
        <field name="product_uos_qty" invisible="1" />
        <field name="included_tax_amount_import" invisible="1" />
        <field name="exchange_rate_import" invisible="1" />
        <field name="line_total_amount" invisible="1" />
        <field name="quantity" type="measure" string="Cantidad" />
        <field name="item_total_amount" type="measure" string="Total de artículo" />
        <field name="line_subtotal_amount" type="measure" string="Subtotal max" />
        <field name="total_order_amount" type="measure" string="Total max" />
      </pivot>
    </field>
  </record>

  <record id="sale_order_import_line_view_form_drc_columns" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field name="priority">99</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_form"
    />
    <field name="arch" type="xml">
      <sheet position="replace">
        <sheet>
          <group>
            <group>
              <field name="origin_import" string="Origen" readonly="state == 'done'" />
              <field
                name="date_order"
                string="Fecha pedido"
                readonly="state == 'done'"
              />
              <field
                name="customer_name"
                string="Nombre cliente"
                readonly="state == 'done'"
              />
              <field
                name="warehouse_name_import"
                string="Almacén"
                readonly="state == 'done'"
              />
              <field
                name="sales_team_import"
                string="Equipo de ventas"
                readonly="state == 'done'"
              />
              <field
                name="client_order_ref"
                string="Número pedido cliente"
                readonly="state == 'done'"
              />
              <field
                name="currency_code_import"
                string="Código de moneda"
                readonly="state == 'done'"
              />
            </group>
            <group>
              <field
                name="product_name"
                string="Nombre producto"
                readonly="state == 'done'"
              />
              <field
                name="product_code"
                string="Código producto"
                readonly="state == 'done'"
              />
              <field name="quantity" string="Cantidad" readonly="state == 'done'" />
              <field
                name="price_unit"
                string="Precio unitario"
                readonly="state == 'done'"
              />
              <field
                name="included_tax_amount_import"
                string="Impuesto incluido"
                readonly="state == 'done'"
              />
              <field
                name="item_total_amount"
                string="Total de artículo"
                readonly="state == 'done'"
              />
              <field
                name="line_subtotal_amount"
                string="Subtotal de línea"
                readonly="state == 'done'"
              />
              <field
                name="total_order_amount"
                string="Total importe pedido"
                readonly="state == 'done'"
              />
            </group>
          </group>
          <field name="historical" invisible="1" />
          <field name="log_info" />
        </sheet>
      </sheet>
    </field>
  </record>

  <record id="sale_order_import_line_view_tree_drc_columns" model="ir.ui.view">
    <field name="model">sale.order.import.line</field>
    <field name="priority">99</field>
    <field
      name="inherit_id"
      ref="sale_import_wizard.sale_order_import_line_view_tree"
    />
    <field name="arch" type="xml">
      <list position="replace">
        <list
          decoration-danger="state == 'error'"
          decoration-muted="state == 'done'"
          decoration-it="log_info"
          editable="top"
        >
          <field
            name="origin_import"
            string="Origen"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="date_order"
            string="Fecha pedido"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="customer_name"
            string="Nombre cliente"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="warehouse_name_import"
            string="Almacén"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="sales_team_import"
            string="Equipo de ventas"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="client_order_ref"
            string="Número pedido cliente"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="currency_code_import"
            string="Código de moneda"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="product_name"
            string="Nombre producto"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="product_code"
            string="Código producto"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="quantity"
            string="Cantidad"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="price_unit"
            string="Precio unitario"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="included_tax_amount_import"
            string="Impuesto incluido"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="item_total_amount"
            string="Total de artículo"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="line_subtotal_amount"
            string="Subtotal de línea"
            readonly="state == 'done'"
            optional="show"
          />
          <field
            name="total_order_amount"
            string="Total importe pedido"
            readonly="state == 'done'"
            optional="show"
          />
          <field name="state" invisible="1" />
          <field name="log_info" invisible="1" />
        </list>
      </list>
    </field>
  </record>
</odoo>
