<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="module_category_endesa_deliveries" model="ir.module.category">
    <field name="name">Endesa Deliveries</field>
    <field name="sequence">60</field>
  </record>

  <record id="group_endesa_user" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="module_category_endesa_deliveries" />
    <field
      name="comment"
    >Sees the Endesa deliveries and the Endesa fields of sale orders.</field>
  </record>

  <record id="group_endesa_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="category_id" ref="module_category_endesa_deliveries" />
    <field name="implied_ids" eval="[Command.link(ref('group_endesa_user'))]" />
    <field
      name="users"
      eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
    />
    <field name="comment">Also edits the Endesa fields.</field>
  </record>
</odoo>
