<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="sale_order_view_form_inherit_catalog" model="ir.ui.view">
    <field name="name">sale.order.view.form.inherit.catalog</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <field name="partner_shipping_id" position="after">
        <field name="catalog_ids" widget="many2many_tags" readonly="1" />
        <field name="is_prebook" />
      </field>
      <xpath
        expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
        position="before"
      >
        <field name="catalog_id" optional="show" />
      </xpath>
    </field>
  </record>
</odoo>
