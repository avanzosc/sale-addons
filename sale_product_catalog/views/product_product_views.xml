<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_product_form_view_inherit_catalog" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="catalog_ids" widget="many2many_tags" readonly="1" />
      </field>
    </field>
  </record>

  <record id="product_product_view_form" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
    <field name="arch" type="xml">
      <group name="sales" position="inside">
        <field name="catalog_ids" widget="many2many_tags" />
      </group>
    </field>
  </record>

  <record id="product_product_view_tree" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="catalog_ids" widget="many2many_tags" optional="hide" />
      </field>
    </field>
  </record>
</odoo>
