<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_catalog_type_view_list" model="ir.ui.view">
    <field name="name">product.catalog.type.view.list</field>
    <field name="model">product.catalog.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="incompatible_type_ids" widget="many2many_tags" />
      </list>
    </field>
  </record>

  <record id="product_catalog_type_view_form" model="ir.ui.view">
    <field name="name">product.catalog.type.view.form</field>
    <field name="model">product.catalog.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="incompatible_type_ids" widget="many2many_tags" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_catalog_type_action" model="ir.actions.act_window">
    <field name="name">Catalog Types</field>
    <field name="res_model">product.catalog.type</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
