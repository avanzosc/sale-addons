<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_catalog_multicompany_rule" model="ir.rule">
    <field name="name">Product Catalog multi-company</field>
    <field name="model_id" ref="model_product_catalog" />
    <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
  </record>
</odoo>
