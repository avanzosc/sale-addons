<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_attribute_catalog_report_view_pivot" model="ir.ui.view">
    <field name="model">product.attribute.catalog.report</field>
    <field name="arch" type="xml">
      <pivot string="Competences Report" disable_linking="True">
        <field name="catalog_id" type="row" />
        <field name="product_id" type="row" />
        <field name="attribute_id" type="col" />
        <field name="attribute_value_id" type="col" />
      </pivot>
    </field>
  </record>
  <record id="product_attribute_catalog_report_view_tree" model="ir.ui.view">
    <field name="model">product.attribute.catalog.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="catalog_id" />
        <field name="product_id" />
        <field name="attribute_id" />
        <field name="attribute_value_id" />
      </list>
    </field>
  </record>
  <record id="product_attribute_catalog_report_view_search" model="ir.ui.view">
    <field name="model">product.attribute.catalog.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="catalog_id" />
        <field name="product_id" />
        <field name="attribute_id" />
        <field name="attribute_value_id" />
      </search>
    </field>
  </record>

  <record id="action_product_attribute_catalog_report" model="ir.actions.act_window">
    <field name="name">Product Attribute catalogs</field>
    <field name="type">ir.actions.act_window</field>
    <field
      name="view_id"
      ref="sale_report_product_attributes.product_attribute_catalog_report_view_pivot"
    />
    <field name="res_model">product.attribute.catalog.report</field>
    <field name="view_mode">pivot,list,form</field>
    <field name="search_view_id" ref="product_attribute_catalog_report_view_search" />
  </record>
</odoo>
