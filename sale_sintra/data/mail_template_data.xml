<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="mail_template_sales_notice" model="mail.template">
    <field name="name">Sintra: Notice to Sales</field>
    <field name="model_id" ref="model_sale_sintra" />
    <field name="subject">Sintra {{ object.name }}</field>
    <field name="body_html" type="html">
      <div>
        <p>A Sintra is pending for Sales.</p>
        <p>Objective: <strong t-out="object.name" /></p>
        <p>Installation: <t t-out="object.installation or ''" /></p>
      </div>
    </field>
    <field name="auto_delete" eval="True" />
  </record>
</odoo>
