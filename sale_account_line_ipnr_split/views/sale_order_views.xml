<odoo>
    <record id="action_sale_order_ipnr_split" model="ir.actions.server">
        <field name="name">IPNR – Line Breakdown</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_ipnr_split()</field>
    </record>
        <record id="action_sale_order_ipnr_reverse" model="ir.actions.server">
        <field name="name">IPNR – Line Breakdown REVERT</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_ipnr_reverse()</field>
    </record>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.ipnr.gross.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='order_line']/tree/field[@name='price_unit']"
        position="after"
      >
                <field
          name="ipnr_gross_price_unit"
          string="Unit price with IPNR"
          optional="hide"
        />
            </xpath>
        </field>
    </record>
</odoo>
