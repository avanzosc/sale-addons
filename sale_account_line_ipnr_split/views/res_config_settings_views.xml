<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
        <div id="sale_ebay" position="before">
            <h2>IPNR</h2>
            <div class="row mt16 o_settings_container">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label for="x_ipnr_product_id" string="IPNR Product" />
                        <div class="text-muted">
                            Product used for IPNR breakdown lines.
                        </div>
                        <div class="content-group mt8">
                            <field name="x_ipnr_product_id" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label
                for="x_ipnr_rounding_digits"
                string="Rounding decimals"
              />
                        <div class="text-muted">
                            Decimal places used when rounding IPNR prices.
                        </div>
                        <div class="content-group mt8">
                            <field name="x_ipnr_rounding_digits" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </field>
</record>
</odoo>
