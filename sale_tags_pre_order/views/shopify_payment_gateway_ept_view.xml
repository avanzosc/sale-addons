<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="shopify_payment_gateway_tree" model="ir.ui.view">
    <field name="model">shopify.payment.gateway.ept</field>
    <field name="inherit_id" ref="shopify_ept.shopify_payment_gateway_tree" />
    <field name="arch" type="xml">
      <field name="code" position="after">
        <field name="journal_id" />
      </field>
    </field>
  </record>

  <record id="shopify_payment_gateway_form" model="ir.ui.view">
    <field name="model">shopify.payment.gateway.ept</field>
    <field name="inherit_id" ref="shopify_ept.shopify_payment_gateway_form" />
    <field name="arch" type="xml">
      <field name="code" position="after">
        <field name="journal_id" />
      </field>
    </field>
  </record>
</odoo>
